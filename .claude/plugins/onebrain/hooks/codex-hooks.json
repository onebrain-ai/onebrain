{
  "description": "Native Codex lifecycle hooks for OneBrain. Every hook is fail-open.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "onebrain hook",
            "commandWindows": "onebrain hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "onebrain hook",
            "commandWindows": "onebrain hook",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "onebrain hook",
            "commandWindows": "onebrain hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
